{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentdoctor.local/schemas/v2/secret-scan.json",
  "title": "SecretScanReport",
  "type": "object",
  "required": ["root", "enabled", "filesScanned", "findings", "limitations"],
  "properties": {
    "root": { "type": "string" },
    "enabled": { "type": "boolean" },
    "filesScanned": { "type": "integer" },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["file", "line", "ruleId", "redactedSnippet", "severity"],
        "properties": {
          "file": { "type": "string" },
          "line": { "type": "integer" },
          "ruleId": { "type": "string" },
          "redactedSnippet": { "type": "string" },
          "severity": { "type": "string", "enum": ["critical", "warning"] }
        }
      }
    },
    "limitations": { "type": "array", "items": { "type": "string" } }
  }
}
